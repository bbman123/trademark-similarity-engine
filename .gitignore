# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl
MANIFEST

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
.env
ENV/

# ── Environment variables ─────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Jupyter Notebooks ─────────────────────────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/
*.ipynb_checkpoints

# ── pip temp / cache ──────────────────────────────────────────────────────────
.piptmp/
pip-wheel-metadata/
*.pip

# ── ML Models & Checkpoints ───────────────────────────────────────────────────
# Model weights and binaries — large files, not tracked in git
# models/*.h5
# models/*.keras
# models/*.pkl
# models/*.pt
# models/*.pth
# models/*.bin
# models/*_tokenizer.pkl
# results/ outputs are small JSON/PNG — kept in git
# !results/

# ── Data files ────────────────────────────────────────────────────────────────
# Raw / processed CSVs are typically large — exclude from git
# data/*.csv
# Uncomment to track small reference files:
# !data/trademark_file.csv

# ── Visualizations (generated outputs) ───────────────────────────────────────
# eda_visualizations/
# eda_visualizations_*/

# ── IDEs & Editors ────────────────────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs & Temp ───────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.swp
*.swo
*.orig
# pip install output log files (e.g. 5.2.0, 2.15.1)
[0-9].[0-9].[0-9]
[0-9].[0-9]*.[0-9]*

# ── Pipeline state (regenerated by running Step 1) ────────────────────────────
pipeline_config.json

# ── Coverage & Testing ────────────────────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
.tox/
